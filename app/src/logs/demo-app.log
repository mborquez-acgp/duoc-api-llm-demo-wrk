    title "Distribución de Cargos y Abonos por Fecha"
    x-axis ["YYYY-MM-DD", "YYYY-MM-DD"]
    y-axis "Monto Total"
    bar "Cargos" [100.50, 200.00]
    bar "Abonos" [50.25, 300.10]"
}
